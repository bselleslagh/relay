# Copy to .env (never commit it) and fill in. Generate the token with: openssl rand -hex 32
RELAY_HUB_MCP_TOKEN=

# IANA time zone used for "today", daily totals and meals logged without a UTC offset.
RELAY_HUB_TIMEZONE=Europe/Brussels

# Optional: only accept requests that Tailscale Serve signs with one of these logins (comma-separated).
# Requests from the host itself or from tagged devices carry no login and are refused when this is set.
RELAY_HUB_TAILSCALE_LOGINS=

# Host port bound on 127.0.0.1 by compose.yaml.
RELAY_HUB_PUBLISH_PORT=8787
